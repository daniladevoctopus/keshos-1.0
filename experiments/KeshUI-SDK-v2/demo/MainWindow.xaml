<Window xmlns="http://schemas.keshos.dev/keshui/2026"
        xmlns:x="http://schemas.keshos.dev/xaml/2026"
        x:Class="KeshUI.Gallery.MainWindow"
        Title="KeshUI Gallery · Fluent 2 visual pass" Width="1440" Height="900">
  <Window.Resources>
    <ResourceDictionary>
      <Style x:Key="CommandButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="116" />
        <Setter Property="CornerRadius" Value="4" />
      </Style>
      <Style x:Key="WideCommandButtonStyle"
             TargetType="Button"
             BasedOn="{StaticResource CommandButtonStyle}">
        <Setter Property="MinWidth" Value="150" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Columns="224,*">
    <Border Grid.Column="0"
            Background="{ThemeResource LayerFillColorAltBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Padding="12,16,12,16">
      <StackPanel Spacing="8">
        <StackPanel Padding="8,4,8,16" Spacing="3">
          <TextBlock Text="KeshUI" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="SDK gallery" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <TextBlock Text="Explore" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="10,0,0,2" />

        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4">
          <Grid Columns="3,*">
            <Border Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="2" />
            <TextBlock Grid.Column="1" Text="Home" FontSize="14" FontWeight="SemiBold" Margin="13,8,8,8" />
          </Grid>
        </Border>

        <TextBlock Text="Controls" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16,8,8,8" />
        <TextBlock Text="Layout" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16,8,8,8" />
        <TextBlock Text="Navigation" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16,8,8,8" />
        <TextBlock Text="Input" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16,8,8,8" />

        <Separator />
        <TextBlock Text="Framework" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="10,2,0,2" />
        <TextBlock Text="Resources and styles" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16,8,8,8" />
        <TextBlock Text="Data binding" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16,8,8,8" />
        <TextBlock Text="XAML compiler" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16,8,8,8" />
        <TextBlock Text="Prism bridge" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16,8,8,8" />

        <Separator />
        <TextBlock Text="KeshUI v0.3" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="10,8,0,0" />
        <TextBlock Text="C++20 · compiled XAML" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="10,0,0,0" />
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
      <ScrollViewer>
        <StackPanel Padding="32,26,40,44" Spacing="22">
          <BreadcrumbBar Items="KeshUI;Gallery;Fluent 2" />

          <Grid Columns="*,Auto">
            <StackPanel Grid.Column="0" Spacing="5">
              <TextBlock Text="Fluent 2 controls for KeshUI" FontSize="32" FontWeight="SemiBold" />
              <TextBlock Text="Neutral surfaces, semantic tokens, compact spacing and one clear Kesh brand accent." FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <SearchBox Grid.Column="1" Width="250" PlaceholderText="Search controls" Margin="20,4,0,0" />
          </Grid>

          <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="0">
            <Grid Columns="4,*">
              <Border Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="2" />
              <StackPanel Grid.Column="1" Padding="14,10,14,10" Spacing="2">
                <TextBlock Text="Fluent 2 visual reference is active" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Public Fluent tokens now drive the gallery's neutral surfaces, spacing, shape and hierarchy." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Grid>
          </Border>

          <StackPanel Spacing="12">
            <TextBlock Text="Foundations" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Fluent 2 relies on semantic tokens instead of painting every component independently." FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Card Width="252" Title="Color" Subtitle="Neutral + brand" Content="Background · foreground · stroke" />
              <Card Width="252" Title="Typography" Subtitle="Windows hierarchy" Content="12 · 14 · 20 · 28 · 32" />
              <Card Width="252" Title="Spacing" Subtitle="4 px rhythm" Content="8 · 12 · 16 · 24 · 32" />
              <Card Width="252" Title="Shape" Subtitle="Small radii" Content="4 px controls · 8 px cards" />
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="12">
            <TextBlock Text="Buttons and commands" FontSize="20" FontWeight="SemiBold" />
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
              <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <AccentButton Content="Primary action" Click="OnAccentButton" />
                  <Button Style="{StaticResource CommandButtonStyle}" Content="Standard" Click="OnStandardButton" />
                  <HyperlinkButton Content="Subtle action" Click="OnHyperlink" />
                  <Badge Content="New" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Text="One primary action, then neutral or subtle commands."
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="12">
            <TextBlock Text="Selection and values" FontSize="20" FontWeight="SemiBold" />
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
              <StackPanel Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="24">
                  <ToggleSwitch Width="160" Header="Motion" IsOn="True" VerticalAlignment="Center" />
                  <CheckBox Content="Telemetry" IsChecked="True" VerticalAlignment="Center" />
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <RadioButton Width="22" IsChecked="True" VerticalAlignment="Center" />
                    <TextBlock Text="Stable channel" FontSize="14" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="18">
                  <Slider Width="320" Minimum="0" Maximum="100" Value="68" VerticalAlignment="Center" />
                  <ProgressBar Width="260" Value="68" VerticalAlignment="Center" />
                  <ProgressRing Value="68" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="12">
            <TextBlock Text="Text, choice and navigation" FontSize="20" FontWeight="SemiBold" />
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
              <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBox Width="250" PlaceholderText="Text field" />
                  <SearchBox Width="250" PlaceholderText="Search controls" />
                  <ComboBox Width="230" Items="C++;C# binding (future);Rust binding (future)" SelectedIndex="0" />
                </StackPanel>
                <TabView Tabs="Overview;API;XAML;Tokens" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Spacing="12">
            <TextBlock Text="Compiled XAML runtime" FontSize="20" FontWeight="SemiBold" />
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="x:Name and ElementName binding are compiled before link time." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBox x:Name="BindingSourceBox" Width="300" Text="Hello from KXamlC" PlaceholderText="Binding source" />
                  <TextBlock x:Name="BindingTargetText"
                             Width="320"
                             Text="{Binding ElementName=BindingSourceBox, Path=Text, Mode=OneTime, FallbackValue=Binding unavailable}"
                             FontSize="14" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Style="{StaticResource WideCommandButtonStyle}" Content="Toggle light / dark" Click="OnToggleTheme" />
                  <Button Style="{StaticResource CommandButtonStyle}" Content="Dialog demo" Click="OnDialogDemo" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <Separator />
          <TextBlock Text="KeshUI SDK v0.3 · Fluent 2 reference pass · KXamlC · X11/Cairo/Pango · Prism-ready"
                     FontSize="12"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
